-def _rotate_batch(vector, angle):
-    c, s = np.cos(angle), np.sin(angle)
-    return np.stack((c*vector[..., 0]-s*vector[..., 1],
-                     s*vector[..., 0]+c*vector[..., 1]), axis=-1)

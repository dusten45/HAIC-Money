+.timeline { display: grid; grid-template-columns: 35px 1fr 35px; align-items: center; gap: 8px; color: var(--muted); font-size: 11px; margin: 10px 0 16px; }
+.timeline input { padding: 0; min-height: 0; accent-color: var(--accent); }
+.metrics-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
+.metric-card { padding: 12px; border: 1px solid var(--line); border-radius: 10px; background: #101620; min-width: 0; }
+.metric-card span { color: var(--muted); display: block; font-size: 10px; text-transform: uppercase; letter-spacing: .08em; margin-bottom: 6px; }
+.metric-card strong { display: block; overflow: hidden; text-overflow: ellipsis; font-size: 15px; }
+.site-footer { color: var(--muted); font-size: 11px; padding: 24px 0 38px; }
+@media (max-width: 1050px) { .workspace { grid-template-columns: 1fr; } }
+@media (max-width: 650px) { .site-header { padding-top: 28px; flex-direction: column; align-items: flex-start; } .site-header, .workspace, .site-footer { width: min(100% - 24px, 1480px); } .panel { padding: 15px; } .settings-grid, .custom-settings { grid-template-columns: repeat(2, 1fr); } .custom-settings .button { grid-column: span 2; } .obstacle-form { grid-template-columns: repeat(3, 1fr); } .obstacle-form .button { grid-column: span 3; } .file-drop { grid-template-columns: 1fr; } .speed-label { margin-left: 0; } .control-point-toolbar, .run-panel-heading { align-items: flex-start; flex-direction: column; } .manual-help { flex-direction: column; } .run-toolbar > label:not(.checkbox-label) { min-width: min(100%, 175px); flex: 1; } .run-toolbar > button { flex: 1; } }

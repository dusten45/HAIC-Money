+.manual-help { display: flex; justify-content: space-between; gap: 10px; color: var(--muted); font-size: 10px; margin-top: 11px; }
+.manual-help #manual-action-status { color: var(--accent-2); }
+.replay-controls { margin: 14px 0; }

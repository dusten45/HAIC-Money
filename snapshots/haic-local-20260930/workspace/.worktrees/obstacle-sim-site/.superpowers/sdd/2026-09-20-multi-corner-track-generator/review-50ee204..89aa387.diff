+.data-table tr:last-child td { border-bottom: 0; }
+.data-table input { min-height: 30px; padding: 5px 7px; width: 88px; }
+.empty-cell { text-align: center; color: var(--muted); padding: 18px !important; }
+.hint, .status-message { color: var(--muted); font-size: 11px; line-height: 1.5; }
+.generated-track-summary { margin: 8px 2px 0; color: var(--accent-2); }

+.status-message { min-height: 18px; margin: 9px 2px; }
+.run-panel { border: 1px solid var(--line); border-radius: 12px; background: #101620; padding: 14px; margin: 17px 0 13px; }
+.run-toolbar { display: flex; align-items: end; gap: 8px; flex-wrap: wrap; margin-top: 12px; }
+.run-toolbar > label:not(.checkbox-label) { min-width: 155px; }
+.run-toolbar select { min-height: 38px; padding: 8px; }
+.checkbox-label { display: flex; align-items: center; gap: 8px; min-height: 38px; padding: 0 5px; white-space: nowrap; }

{
  "schema_version": 1,
  "project": {
    "id": "haic-money",
    "name": "2026 HAIC CarRacing research",
    "scope": "haic-only"
  },
  "paths": {
    "run_root": "runs/haic-research-v2",
    "artifact_root": "artifacts/haic-research-v2",
    "pdf_root": "output/pdf",
    "legacy_paths": [
      "runs",
      "artifacts/haic",
      "submissions",
      "report.pdf"
    ]
  },
  "official_sources": [
    {
      "precedence": 1,
      "id": "competition_site",
      "url": "https://ships-duo-ethical-saver.trycloudflare.com/"
    },
    {
      "precedence": 2,
      "id": "participants_repository",
      "url": "https://github.com/2026-HAIC/Participants"
    },
    {
      "precedence": 3,
      "id": "local_source_mirror",
      "path": "docs/sources/official-participants/README.md",
      "license_path": "docs/sources/official-participants/LICENSE",
      "source_commit": "1c11db8afc2fbfcfb610672b7ee0ecd122c97741"
    },
    {
      "precedence": 4,
      "id": "historical_evidence",
      "path": "COMPETITION_INFO.md",
      "related_paths": [
        "RESULTS.md"
      ]
    }
  ],
  "workflow": {
    "default_mode": "plan-only",
    "states": [
      "STOPPED",
      "DISCOVER",
      "HYPOTHESIZE",
      "DESIGN_PENDING_APPROVAL",
      "IMPLEMENT_PENDING_APPROVAL",
      "EXECUTE_PENDING_APPROVAL",
      "EVALUATE",
      "ADVANCE",
      "REJECT",
      "REVISE",
      "PIVOT",
      "GATE_REVIEW_ADVANCE",
      "GATE_REVIEW_REJECT",
      "GATE_REVIEW_REVISE",
      "GATE_REVIEW_PIVOT",
      "RELEASE_IF_GATE_PASS"
    ],
    "separate_approval_stages": [
      "design",
      "execution"
    ],
    "pivot_after_valid_non_improving_cycles": 3,
    "gates": [
      "rule_compliance",
      "mechanism_activation",
      "competitive_or_product_outcome"
    ]
  },
  "search": {
    "min_independent_directions": 4,
    "max_candidates_per_batch": 8,
    "max_candidates_per_direction": 2,
    "threshold_sweep_requires_mechanism_activation": true
  },
  "metrics": {
    "primary": "completion_rate",
    "tie_breakers": [
      "median_finished_lap_ms",
      "mean_incomplete_progress",
      "p90_finished_lap_ms",
      "collisions",
      "damage",
      "act_latency_p95_ms"
    ],
    "official_score_is_separate": true
  },
  "splits": {
    "ids": [
      "train",
      "tune",
      "held_out",
      "confirmation",
      "blind",
      "official"
    ],
    "protected_ids": [
      "confirmation",
      "blind"
    ],
    "blind_tuning_allowed": false,
    "consumed_confirmation_reusable_as_fresh": false
  },
  "commands": {
    "default_mode": "plan-only",
    "allow_shell": false,
    "profiles": {
